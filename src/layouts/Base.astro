---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/home.css';
import '../styles/wizard.css';
import '../styles/service.css';
import { businessName, phone, phoneHref, email, serviceAreas } from '../data/brief';
import { MARKETS } from '../data/markets';
import { SERVICES } from '../data/services';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import EstimateWizard from '../components/EstimateWizard.astro';
import logo from '../assets/brand/logo.png';
import logoRev from '../assets/brand/logo-reverse.png';

interface Props {
  title: string;
  description: string;
  /** The answer-box question + ~60-word answer, for AEO extraction. */
  answer?: { question: string; answer: string };
  /** Visible breadcrumbs are mirrored into BreadcrumbList on every programmatic tier. */
  crumbs?: { name: string; item: string }[];
  /** e.g. "noindex" for /thanks/ and 404 — never on a money page. */
  robots?: string;
  /** /estimate/ carries the wizard inline, so it must not also carry the dialog: one "quote" form per page. */
  noEstimate?: boolean;
  /** Visible FAQ, mirrored into FAQPage for answer engines. Answers may hold links; tags are stripped here. */
  faq?: { q: string; a: string }[];
}
const { title, description, answer, crumbs, robots, noEstimate = false, faq } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const graph: any[] = [
  {
    '@type': 'Organization',
    '@id': `${Astro.site}#organization`,
    name: businessName,
    url: Astro.site?.href,
    ...(phone ? { telephone: phone } : {}),
    ...(email ? { email } : {}),
  },
  {
    '@type': 'WebSite',
    '@id': `${Astro.site}#website`,
    url: Astro.site?.href,
    name: businessName,
    publisher: { '@id': `${Astro.site}#organization` },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    isPartOf: { '@id': `${Astro.site}#website` },
    about: { '@id': `${Astro.site}#organization` },
    ...(answer ? { speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.answer-box__a', '.hero__lede', '.areas__intro'] } } : {}),
  },
];

if (faq?.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&') },
    })),
  });
}

if (crumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name, item: c.item,
    })),
  });
}
/* NO LocalBusiness node here. One is emitted only where a real, staffed, verified
   address exists behind a live GBP — never per-city, never speculatively.
   NO aggregateRating and NO Review, ever: Google rules self-serving review markup
   ineligible, and inventing it is the FTC failure this system exists to prevent. */
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#0E0E0C" />
{robots && <meta name="robots" content={robots} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL('/brand/og.jpg', Astro.site).href} />
<meta property="og:site_name" content={businessName} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Instrument+Sans:wght@400;500;600&display=swap" />
<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
</head>
<body>
  <div class="progress" aria-hidden="true"><span></span></div>
  <a class="skip" href="#main">Skip to content</a>

  <div class="util"><div class="util__in">
    <span>Denver · Myrtle Beach · Jacksonville</span>
    <span>13 years&rsquo; experience · Free estimates</span>
    {phoneHref && <span><a class="util__tel" href={phoneHref} data-cta="call-util">{phone}</a></span>}
  </div></div>

  <header class="chrome">
    <div class="chrome__in">
      <a class="chrome__mark" href="/" aria-label={`${businessName} — home`}>
        <Image src={logo} alt="" width={140} densities={[1, 2]} class="chrome__logo" loading="eager" />
      </a>
      <button class="chrome__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="chrome__menu-ico" aria-hidden="true"></span><span class="chrome__menu-lbl">Menu</span>
      </button>
    </div>
  </header>

  <div class="menu turf-marks turf-marks--dark" id="menu" hidden>
    <div class="menu__in">
      <div class="menu__head">
        <Image src={logoRev} alt={businessName} width={160} densities={[1, 2]} class="menu__logo" loading="lazy" />
        <button class="menu__close" type="button" data-menu-toggle>Close</button>
      </div>
      <nav class="menu__nav" aria-label="Menu">
        <div>
          <p class="micro">What we install</p>
          <ul>{SERVICES.map((sv) => <li><a href={`/services/${sv.slug}/`}>{sv.name}</a></li>)}</ul>
        </div>
        <div>
          <p class="micro">Where we work</p>
          <ul>{MARKETS.map((m) => <li><a href={`/${m.slug}/`}>{m.name}</a></li>)}</ul>
        </div>
        <div>
          <p class="micro">The rules</p>
          <ul><li><a href="/guides/">Turf rules by state</a></li></ul>
        </div>
      </nav>
      <div class="menu__cta">
        <a class="btn btn--light btn--lg" href="/estimate/" data-estimate data-cta="quote-menu">Get a free estimate</a>
        {phoneHref && <a class="btn btn--primary btn--lg" href={phoneHref} data-cta="call-menu">Call {phone}</a>}
      </div>
      <p class="menu__foot">Denver Metro · The Grand Strand · Northeast Florida</p>
    </div>
  </div>

  <main id="main">
    <slot />
  </main>

  <footer class="foot turf-marks turf-marks--dark">
    <div class="foot__in">
      <Image src={logoRev} alt="" width={220} densities={[1, 2]} class="foot__logo" loading="lazy" />
      <p class="foot__name">{businessName}</p>
      <nav class="foot__nav" aria-label="Footer">
        <div>
          <p class="micro">Where we work</p>
          <ul>{MARKETS.map((m) => <li><a href={`/${m.slug}/`}>{m.name}</a></li>)}</ul>
        </div>
        <div>
          <p class="micro">What we install</p>
          <ul>{SERVICES.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}</ul>
        </div>
        <div>
          <p class="micro">The rules</p>
          <ul><li><a href="/guides/">Turf rules by state</a></li></ul>
        </div>
      </nav>
      {phoneHref && <a class="foot__tel" href={phoneHref} data-cta="call-footer">{phone}</a>}
      <p class="foot__legal">&copy; {new Date().getFullYear()} {businessName}</p>
    </div>
  </footer>

  {phoneHref && (
    <div class="bar">
      <a class="btn bar__call" href={phoneHref} data-cta="call-sticky"><Icon name="phone" />Call now</a>
      <a class="btn bar__quote" href="/estimate/" data-estimate data-cta="quote-sticky">Free estimate</a>
    </div>
  )}
  {!noEstimate && (
    <dialog class="estimate" aria-label="Free estimate">
      <div class="estimate__card">
        <button class="estimate__x" type="button" data-estimate-close aria-label="Close"><Icon name="x" /></button>
        <EstimateWizard mode="modal" />
      </div>
    </dialog>
  )}
  <script>import '../scripts/motion'; import '../scripts/estimate';</script>
</body>
</html>
