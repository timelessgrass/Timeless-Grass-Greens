---
/** Practical follow-up questions. Internal research is retained separately from public links. */
import PublicReferences from './PublicReferences.astro';
import EXTRA from '../data/extra.json';
interface Props { slug: string; startDark?: boolean; collapsed?: boolean; title?: string }
interface Section { h2: string; body: string[]; sources: { label: string; url?: string }[]; publicReferences?: string[] }
const { slug, startDark = false, collapsed = false, title = 'Before installation' } = Astro.props;
const sections = (EXTRA as Record<string, { sections: Section[] }>)[slug]?.sections ?? [];
const sources = sections.flatMap((section) => section.sources);
const selected = sections.flatMap((section) => section.publicReferences ?? []);
const ground = (i: number) => (startDark ? i % 2 === 0 : i % 2 === 1) ? 'sec sec--band' : 'sec';
---
{collapsed ? sections.length > 0 && (
  <section class="sec sec--band fine">
    <div class="wrap">
      <div class="kick kick--left" data-reveal><h2>{title}</h2></div>
      <div class="faq" data-reveal>
        {sections.map((section) => (
          <details class="qa"><summary><h3>{section.h2}</h3></summary>
            {section.body.map((para) => <p set:html={para} />)}
          </details>
        ))}
      </div>
      <PublicReferences sources={sources} selected={selected} />
    </div>
  </section>
) : sections.length > 0 && (
  <>
    {sections.map((section, i) => (
      <section class={ground(i)}>
        <div class="wrap doc__sec" data-reveal>
          <h2>{section.h2}</h2>
          {section.body.map((para) => <p set:html={para} />)}
          <PublicReferences sources={section.sources} selected={section.publicReferences} />
        </div>
      </section>
    ))}
  </>
)}
