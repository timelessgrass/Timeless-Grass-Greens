---
/**
 * Sourced sections appended to a page, from src/data/extra.json.
 *
 * Every paragraph here was drafted against the statutes, the research archive and the two
 * client sources, then put through an adversarial verify pass. 8 sentences were cut, 48
 * rewritten and 52 citations dropped before any of it landed in the file. The sources
 * render with the copy for the same reason the guides do: a claim and its receipt belong
 * in the same place.
 */
import EXTRA from '../data/extra.json';

interface Props { slug: string; startDark?: boolean }
const { slug, startDark = false } = Astro.props;
const block = (EXTRA as Record<string, { sections: { h2: string; body: string[]; sources: { label: string; cite: string; url: string; checked: string }[] }[] }>)[slug];
const sections = block?.sections ?? [];
const sources = sections.flatMap((s) => s.sources);
const ground = (i: number) => {
  const dark = startDark ? i % 2 === 0 : i % 2 === 1;
  return dark ? 'sec sec--band' : 'sec';
};
---
{sections.map((s, i) => (
  <section class={ground(i)}>
    <div class="wrap doc__sec" data-reveal>
      <h2>{s.h2}</h2>
      {s.body.map((para) => <p set:html={para} />)}
    </div>
  </section>
))}
{sources.length > 0 && (
  <section class={ground(sections.length)}>
    <div class="wrap" data-reveal>
      <p class="micro">Sources</p>
      <ol class="srcs">
        {sources.map((s) => (
          <li>
            <span class="srcs__l">{s.label}</span>
            <span class="srcs__c">{s.cite}</span>
            {s.url && <a class="srcs__u" href={s.url} rel="nofollow noopener">{s.url}</a>}
            <span class="srcs__d">checked {s.checked}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}
