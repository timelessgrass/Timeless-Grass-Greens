---
/* How it works — four steps, each with an icon. motion.ts pins any .proc on wide screens and
   lights the steps in turn as you scroll. Sourced to the old site's "how we work": free site
   consultation, custom design and quote, "you approve the design before we install", "we handle
   all site prep and cleanup". */
import Icon from './Icon.astro';
const STEPS = [
  { icon: 'phone', h: 'Call or send photos', p: 'Tell us about your space and what you want to use it for.' },
  { icon: 'ruler', h: 'Free visit', p: 'We measure the space and check the drainage. No charge.' },
  { icon: 'file', h: 'Written quote', p: 'Your price, the turf and the layout, in writing. No pressure.' },
  { icon: 'shovel', h: 'We install it', p: 'Once you approve the design, we handle it all: prep, turf, edges and cleanup.' },
];
---
<section class="proc sec sec--green on-dark turf-marks turf-marks--dark turf-marks--drift">
  <span class="turf-marks__layer" aria-hidden="true"></span>
  <div class="wrap proc__in">
    <div>
      <p class="micro">How it works</p>
      <h2>You call. We measure. You get a price.</h2>
      <div class="proc__bar"><div class="proc__fill"></div></div>
    </div>
    <div class="proc__steps">
      {STEPS.map((s, i) => (
        <div class="proc__step">
          <span class="proc__ico"><Icon name={s.icon} /></span>
          <h3><i>0{i + 1}</i>{s.h}</h3>
          <p>{s.p}</p>
        </div>
      ))}
    </div>
  </div>
</section>
