---
/**
 * The hero photograph — the LCP element on every page that has one.
 *
 * Eager, high priority, never lazy, with width/height so it cannot shift the layout.
 * The photograph sits at 55% opacity under a dark wash, so it is encoded softer than a
 * content image: the artefacts cannot be seen, the bytes can. WebP only — Astro's AVIF
 * (sharp, 4:4:4 chroma) came out 25–35% LARGER than WebP on these photographs, measured
 * width for width on 2026-09-10. The phone original never reaches a visitor.
 *
 * `sizes` asks for 75vw on phones on purpose: behind the wash nobody can see the difference
 * between the 960 and the 1280 file, and the 960 is half the bytes on the element that sets LCP.
 */
import { Image } from 'astro:assets';
const PHOTOS = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
interface Props { file?: string | null; class?: string }
const { file, class: cls = 'hero__img' } = Astro.props;
const img = file ? PHOTOS[`../assets/photos/${file}`]?.default : undefined;
---
{img && (
  <Image class={cls} src={img} alt="" width={1920} widths={[640, 960, 1280, 1600, 1920]} quality={55}
         sizes="(max-width: 700px) 75vw, 100vw" loading="eager" fetchpriority="high" />
)}
