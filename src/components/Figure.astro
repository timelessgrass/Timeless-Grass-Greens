---
/**
 * A photograph, or an honest hole where one goes.
 *
 * Real file  → renders the <img> with its caption.
 * No file, dev → renders a LABELED placeholder stating which shot belongs here.
 *                It cannot be mistaken for a photograph: no image, stated as
 *                missing, carrying the brief for whoever shoots it.
 * Stock, dev   → renders the licensed stand-in with a visible STOCK label and the
 *                shot brief it is standing in for. Design review only.
 * No file, prod → renders NOTHING. Neither a placeholder nor a stock image can
 *                reach a live page. Only the client's own photograph ships.
 *
 * This is the line the method draws: ship the hole, never a placeholder that
 * reads as real. The old site failed exactly here — 27 AI-generated images
 * presented as the client's own work.
 */
import type { Shot } from '../data/shotlist';
import { Image } from 'astro:assets';

/* Every photograph in src/assets/photos is imported at build time so Astro can emit WebP
   at the widths a page actually uses, with width/height on the tag. 320 and 480 exist for the
   two-up phone grid; 1280 is the ceiling (and the fallback src), which covers the widest slot
   on the page at 2x. WebP, not AVIF: Astro's AVIF came out 25–35% larger on these photographs,
   measured width for width. A 2400px JPEG from a phone is never served to a visitor. */
const PHOTOS = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const photo = (f?: string) => (f ? PHOTOS[`../assets/photos/${f}`]?.default : undefined);
interface Props { shot: Shot; sizes?: string; parallax?: boolean; reveal?: boolean }
/* The default matches a story or band slot. Grids pass their own, otherwise a phone
   fetches a wide file for a half-width slot. */
const { shot, sizes = '(min-width: 1100px) 560px, (min-width: 700px) 46vw, 92vw', parallax = false, reveal = false } = Astro.props;
const DEV = import.meta.env.DEV;
const img = photo(shot.file);
const KIND: Record<string, string> = {
  finished: 'Finished work', before: 'Before', after: 'After',
  team: 'Crew at work', detail: 'Detail', context: 'Context',
};
---
{img ? (
  <figure class="fig" style={`--ratio:${shot.ratio}`} data-parallax={parallax ? '' : undefined} data-reveal={reveal ? 'photo' : undefined}>
    <Image src={img} alt={shot.alt ?? shot.caption ?? ''} width={1280}
           widths={[320, 480, 640, 960, 1280]} quality={66} sizes={sizes}
           loading="lazy" decoding="async" />
    {shot.caption && <figcaption>{shot.caption}</figcaption>}
  </figure>
) : DEV && shot.stock ? (
  <figure class="fig fig--stock" style={`--ratio:${shot.ratio}`} data-shot={shot.id}>
    <img src={shot.stock.src} alt="" loading="lazy" decoding="async" />
    <figcaption class="fig__stock">
      <span>Stock stand-in · not our work · {shot.stock.credit}</span>
      <span class="fig__need">{KIND[shot.kind] ?? shot.kind}: {shot.brief}</span>
    </figcaption>
  </figure>
) : DEV ? (
  <figure class="fig fig--pending" style={`--ratio:${shot.ratio}`} data-shot={shot.id}>
    <div class="fig__slot">
      <p class="fig__kind">{KIND[shot.kind] ?? shot.kind}{shot.pairId ? ` · pair ${shot.pairId}` : ''}</p>
      <p class="fig__brief">{shot.brief}</p>
      <p class="fig__id">{shot.id} · {shot.ratio}</p>
    </div>
  </figure>
) : null}
