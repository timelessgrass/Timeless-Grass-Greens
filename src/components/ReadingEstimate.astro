---
import Icon from './Icon.astro';
import { contactFor } from '../data/contact';
interface Props { preset?: string; cta: string; market?: string }
const { preset = '', cta, market } = Astro.props;
const { phone, phoneHref } = contactFor(market);
const href = preset ? `/estimate/?use=${encodeURIComponent(preset)}` : '/estimate/';
---
<aside class="reading-estimate" aria-label="Plan your installation">
  <p>Planning a turf installation? Get a layout, turf options and a written quote for your space.</p>
  <div class="reading-estimate__actions">
    <a class="btn btn--primary" href={href} data-estimate={preset} data-cta={`quote-reading-${cta}`}>Request a free estimate<Icon name="arrow" /></a>
    {phoneHref && <a class="btn btn--ghost" href={phoneHref} data-cta={`call-reading-${cta}`}>Call {phone}</a>}
  </div>
  <p class="reading-estimate__note">We’ll call to arrange a free site visit.</p>
</aside>
