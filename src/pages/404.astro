---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import OfferPanel from '../components/OfferPanel.astro';
import { phone, phoneHref } from '../data/brief';
import { MARKETS } from '../data/markets';
import { SERVICES } from '../data/services';
const title = 'Page not found | TIMELESS Grass & Greens';
const description = 'That address is not on the site. Every service and every area we work in is one click from here, or call 303-349-2368.';
---
<Base title={title} description={description} robots="noindex, nofollow">
  <section class="hero hero--sub turf-marks turf-marks--dark">
    <div class="wrap">
      <p class="micro micro--accent">404</p>
      <h1>That page isn&rsquo;t here.</h1>
      <hr class="rule-ribbon" />
      <p class="hero__lede">Some addresses changed when we rebuilt the site. Everything we do is one click away below.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/" data-cta="home-404">Go to the homepage</a>
        {phoneHref && <a class="btn btn--ghost" href={phoneHref} data-cta="call-404"><Icon name="phone" />Call {phone}</a>}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="kick kick--left" data-reveal><p class="micro">What we install</p><h2>Anything that&rsquo;s turf.</h2></div>
      <ul class="benefits">
        {SERVICES.map((s) => (
          <li class="benefit benefit--link" data-reveal>
            <a href={`/services/${s.slug}/`} data-cta={`svc-404-${s.slug}`}>
              <span class="benefit__ico"><Icon name={s.icon} /></span>
              <h3 class="benefit__h">{s.name}</h3>
              <p>{s.line}</p>
              <span class="benefit__go">See {s.name.toLowerCase()}<Icon name="arrow" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec sec--band">
    <div class="wrap">
      <div class="kick kick--left" data-reveal><p class="micro">Where we work</p><h2>Do we come to you?</h2></div>
      <ul class="areas">
        {MARKETS.map((m) => (
          <li class="arearow" data-reveal>
            <a href={`/${m.slug}/`} data-cta={`market-404-${m.slug}`}>
              <span class="arearow__n"><Icon name="pin" class="arearow__pin" />{m.name}</span>
              <span class="arearow__t">{m.towns.join(' · ')}</span>
              <span class="arearow__g">See the area &rarr;</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="proof__note">Looking for the turf rules by state? <a href="/guides/">Read the guides</a>.</p>
    </div>
  </section>

  <OfferPanel cta="404" />
</Base>
