---
import Base from '../layouts/Base.astro';
import { phone, phoneHref } from '../data/brief';
import { MARKETS } from '../data/markets';
import { SERVICES } from '../data/services';
const title = 'Page not found | TIMELESS Grass & Greens';
const description = 'That address is not on the site. Some links changed when we rebuilt it. Every market, every service and the turf rules by state are one click from here, or call 303-349-2368.';
---
<Base title={title} description={description} robots="noindex, nofollow">
  <section class="hero hero--sub mown-stripe mown-stripe--dark">
    <div class="wrap">
      <p class="micro micro--accent">404</p>
      <h1>That page isn&rsquo;t here.</h1>
      <hr class="rule-ribbon" />
      <p class="hero__lede">Some addresses changed when we rebuilt the site. Everything we do is one click away below.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/">Go to the homepage</a>
        {phoneHref && <a class="btn btn--ghost" href={phoneHref} data-cta="call-404">Call {phone}</a>}
      </div>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <div class="kick"><p class="micro">Where we work</p><h2>Three markets.</h2></div>
      <ul class="mkts">
        {MARKETS.map((m) => <li><a href={`/${m.slug}/`} data-cta={`market-404-${m.slug}`}><span class="mkts__n">{m.name}</span><span class="mkts__s">{m.towns.join(' · ')}</span></a></li>)}
      </ul>
    </div>
  </section>
  <section class="sec sec--band">
    <div class="wrap">
      <div class="kick"><p class="micro">What we install</p><h2>Anything that&rsquo;s turf.</h2></div>
      <ul class="svcs">
        {SERVICES.map((s) => <li class="svc"><a href={`/services/${s.slug}/`} data-cta={`svc-404-${s.slug}`}><span class="svc__n">{s.name}</span><span class="idx__d">{s.lede}</span></a></li>)}
      </ul>
      <p class="proof__note"><a href="/guides/">Turf rules by state and county</a> — the guides, if that is what you were after.</p>
    </div>
  </section>
</Base>
