---
import OfferPanel from '../../components/OfferPanel.astro';
import Base from '../../layouts/Base.astro';
import { GUIDES } from '../../data/guides';
import { MARKETS } from '../../data/markets';
const crumbs = [
  { name: 'Home', item: `${Astro.site}` },
  { name: 'Guides', item: `${Astro.site}guides/` },
];
const label = (m: string) => MARKETS.find((x) => x.slug === m)?.name ?? 'All markets';
---
<Base
  title="Turf Planning Guides | TIMELESS Grass &amp; Greens"
  description="Plan a turf project in Colorado, the Carolinas or northeast Florida. Find practical guidance on property approvals, drainage, materials and comparing installers."
  crumbs={crumbs}
>
  <section class="hero hero--sub turf-marks turf-marks--dark">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span> <span>Guides</span>
      </nav>
      <h1>Plan your turf project.</h1>
      <hr class="rule-ribbon" />
      <p class="hero__lede">
        Find the questions to ask before choosing turf, approving a layout or comparing estimates.
        Start with the guide that fits your property and the decision you need to make.
      </p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      {GUIDES.length > 0 ? (
        <ul class="idx" data-reveal>
          {GUIDES.map((g) => (
            <li><a href={`/guides/${g.slug}/`} data-cta={`guide-${g.slug}`}>
              <span class="idx__m">{label(g.market)}</span>
              <span class="idx__n">{g.h1}</span>
              <span class="idx__d">{g.description}</span>
            </a></li>
          ))}
        </ul>
      ) : (
        <p>Guides are being written.</p>
      )}
    </div>
  </section>

  <!-- every page ends on the offer -->
  <OfferPanel band cta="guides-index" />
</Base>
