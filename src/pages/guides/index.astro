---
import Base from '../../layouts/Base.astro';
import { GUIDES } from '../../data/guides';
import { MARKETS } from '../../data/markets';
import { phone, phoneHref } from '../../data/brief';
const crumbs = [
  { name: 'Home', item: `${Astro.site}` },
  { name: 'Guides', item: `${Astro.site}guides/` },
];
const label = (m: string) => MARKETS.find((x) => x.slug === m)?.name ?? 'All markets';
---
<Base
  title="Turf Rules by State &amp; County | TIMELESS Grass &amp; Greens"
  description={`What the law actually says about artificial turf in Colorado, the Carolinas and Florida. Statutes cited, dates checked. Call ${phone}.`}
  crumbs={crumbs}
>
  <section class="hero hero--sub mown-stripe mown-stripe--dark">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span> <span>Guides</span>
      </nav>
      <h1>What the rules actually say.</h1>
      <hr class="rule-ribbon" />
      <p class="hero__lede">
        Turf law changed in Colorado, differs across the Carolina state line, and
        restricts what goes under residential turf in Florida. Every page here cites
        the statute and carries the date we last checked it.
      </p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      {GUIDES.length > 0 ? (
        <ul class="idx" data-reveal>
          {GUIDES.map((g) => (
            <li><a href={`/guides/${g.slug}/`} data-cta={`guide-${g.slug}`}>
              <span class="idx__m">{label(g.market)}</span>
              <span class="idx__n">{g.h1}</span>
              <span class="idx__d">{g.description}</span>
            </a></li>
          ))}
        </ul>
      ) : (
        <p>Guides are being written.</p>
      )}
    </div>
  </section>

  <section class="sec sec--dark on-dark close">
    <div class="wrap" data-reveal>
      <h2>Rules differ by address.</h2>
      <p class="close__p">Water district, county and state all matter. Ask us before you count on any of it applying to yours.</p>
      {phoneHref && <a class="btn btn--primary btn--lg" href={phoneHref} data-cta="call-guides-index">Call {phone}</a>}
    </div>
  </section>
</Base>
