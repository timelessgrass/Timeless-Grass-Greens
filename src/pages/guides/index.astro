---
import Extra from '../../components/Extra.astro';
import OfferPanel from '../../components/OfferPanel.astro';
import Base from '../../layouts/Base.astro';
import EXTRA from '../../data/extra.json';
import { GUIDES } from '../../data/guides';
import { MARKETS } from '../../data/markets';
import { phone } from '../../data/brief';
const crumbs = [
  { name: 'Home', item: `${Astro.site}` },
  { name: 'Guides', item: `${Astro.site}guides/` },
];
const label = (m: string) => MARKETS.find((x) => x.slug === m)?.name ?? 'All markets';
/* The offer takes whichever ground the last research section did not, so no two neighbours
   match. Extra with startDark puts even-numbered sections on the band; sources come last. */
const secs = (EXTRA as Record<string, { sections: { sources: unknown[] }[] }>)['guides-index']?.sections ?? [];
const last = secs.some((s) => s.sources.length > 0) ? secs.length : secs.length - 1;
const offerBand = last < 0 || last % 2 === 1;
---
<Base
  title="Turf Rules by State &amp; County | TIMELESS Grass &amp; Greens"
  description={`Artificial turf rules in Colorado, the Carolinas and Florida: HOAs, rebates, infill, permits and licensing, with the statutes cited. Call ${phone}.`}
  crumbs={crumbs}
>
  <section class="hero hero--sub turf-marks turf-marks--dark">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span> <span>Guides</span>
      </nav>
      <h1>What the rules actually say.</h1>
      <hr class="rule-ribbon" />
      <p class="hero__lede">
        Turf rules changed in Colorado, differ across the Carolina state line, and limit what goes
        under turf on Florida home lawns. Here&rsquo;s what each rule says, and what it means for
        your yard.
      </p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      {GUIDES.length > 0 ? (
        <ul class="idx" data-reveal>
          {GUIDES.map((g) => (
            <li><a href={`/guides/${g.slug}/`} data-cta={`guide-${g.slug}`}>
              <span class="idx__m">{label(g.market)}</span>
              <span class="idx__n">{g.h1}</span>
              <span class="idx__d">{g.description}</span>
            </a></li>
          ))}
        </ul>
      ) : (
        <p>Guides are being written.</p>
      )}
    </div>
  </section>

  <Extra slug="guides-index" startDark />

  <!-- every page ends on the offer -->
  <OfferPanel band={offerBand} cta="guides-index" />
</Base>
