---
import Base from '../../layouts/Base.astro';
import OfferPanel from '../../components/OfferPanel.astro';
import PublicReferences from '../../components/PublicReferences.astro';
import ReadingEstimate from '../../components/ReadingEstimate.astro';
import ReadingContents from '../../components/ReadingContents.astro';
import { GUIDES } from '../../data/guides';
import { marketBySlug } from '../../data/markets';

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props;
const sections = g.sections.map((section, i) => ({ ...section, id: `section-${i + 1}` }));
const checklist = sections.find((section) => /checklist/i.test(section.h2));
const m = g.market === 'all' ? null : marketBySlug(g.market);
const crumbs = [
  { name: 'Home', item: `${Astro.site}` },
  { name: 'Guides', item: `${Astro.site}guides/` },
  { name: g.h1, item: `${Astro.site}guides/${g.slug}/` },
];
---
<Base title={g.title} description={g.description} answer={g.answer} crumbs={crumbs} faq={g.faq} schema={[{
  '@type': 'Article', '@id': `${Astro.site}guides/${g.slug}/#article`, headline: g.h1, description: g.description, dateModified: g.updated,
  mainEntityOfPage: `${Astro.site}guides/${g.slug}/`, author: { '@id': `${Astro.site}#organization` }, publisher: { '@id': `${Astro.site}#organization` },
}]}>
  <article class="doc">
    <header class="sec doc__head turf-marks turf-marks--dark">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">/</span>
          <a href="/guides/">Guides</a> <span aria-hidden="true">/</span>
          <span>{g.h1}</span>
        </nav>
        <p class="micro micro--accent">{m ? m.name : 'All markets'}</p>
        <h1>{g.h1}</h1>
        <hr class="rule-ribbon" />
        <p class="doc__meta">Updated {g.updated}</p>
      </div>
    </header>

    <div class="sec doc__reading">
      <div class="wrap doc__layout">
        <div class="answer-box doc__intro">
          <p class="micro">The short version</p>
          <h2 class="answer-box__q">{g.answer.question}</h2>
          <p class="answer-box__a">{g.answer.answer}</p>
          <ReadingEstimate cta={`guide-${g.slug}`} />
          {checklist && <p class="doc__jump"><a href={`#${checklist.id}`}>Jump to the checklist</a></p>}
        </div>
        {sections.length > 1 && <aside class="doc__rail">
          <ReadingContents items={sections.map((s) => ({ id: s.id, label: s.h2 }))} />
        </aside>}
        <div class="doc__body">
          {sections.map((s) => (
            <section class="doc__sec doc__guide-section">
              <h2 id={s.id}>{s.h2}</h2>
              {s.body.map((p) => <p set:html={p} />)}
            </section>
          ))}

          {g.faq && g.faq.length > 0 && (
            <section class="doc__sec" data-reveal>
              <h2>Common questions</h2>
              <div class="faq">
                {g.faq.map((qa) => (
                  <details class="qa">
                    <summary><h3>{qa.q}</h3></summary>
                    <p set:html={qa.a} />
                  </details>
                ))}
              </div>
            </section>
          )}

          <aside class="disclaim">
            <p>
              This page explains the rules that apply to turf installation. It isn&rsquo;t legal
              advice: statutes change and local codes differ, so check with your town, your water
              provider or your HOA before you build.
            </p>
          </aside>

          <PublicReferences sources={g.sources} selected={g.publicReferences} />
        </div>
      </div>
    </div>
  </article>

  <!-- every page ends on the offer -->
  <OfferPanel band cta={`guide-${g.slug}`} />
</Base>
