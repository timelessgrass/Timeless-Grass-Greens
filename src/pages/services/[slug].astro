---
import Base from '../../layouts/Base.astro';
import HeroImage from '../../components/HeroImage.astro';
import Figure from '../../components/Figure.astro';
import Icon from '../../components/Icon.astro';
import Extra from '../../components/Extra.astro';
import OfferPanel from '../../components/OfferPanel.astro';
import Process from '../../components/Process.astro';
import { SERVICES } from '../../data/services';
import { MARKETS } from '../../data/markets';
import { SHOTS } from '../../data/shotlist';
import { getPublishedCollection } from '../../lib/published-content';
import { phone, phoneHref, positioning, fact } from '../../data/brief';

/* Customer flow: offer, options, real work, installation scope, practical questions and estimate.
   Copy and internal evidence are maintained separately; only useful selected references render. */
export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const materials = fact<string>(positioning?.materials);
const shot = (id: string) => SHOTS.find((x) => x.id === id && x.file);
const heroFile = s.heroShot ? shot(s.heroShot)?.file ?? null : null;
const work = s.work.map(shot).filter((x): x is NonNullable<typeof x> => !!x);
/* articles that answer this service's questions, linked from the FAQ; the ones written mainly for it first */
const reads = (await getPublishedCollection('blog')).filter((p) => p.data.related.services.includes(s.slug))
  .sort((a, b) => Number(b.data.related.services[0] === s.slug) - Number(a.data.related.services[0] === s.slug)).slice(0, 6);
/* areas where this service has a page of its own */
const areaPages = new Set((await getPublishedCollection('localServices')).filter((l) => l.data.service === s.slug).map((l) => l.data.market));
const crumbs = [
  { name: 'Home', item: `${Astro.site}` },
  { name: 'Services', item: `${Astro.site}services/` },
  { name: s.name, item: `${Astro.site}services/${s.slug}/` },
];

---
<Base title={s.title} description={s.description} answer={s.answer} crumbs={crumbs} faq={s.faq} schema={[{
  '@type': 'Service', '@id': `${Astro.site}services/${s.slug}/#service`, name: s.name, serviceType: s.name, description: s.description,
  url: `${Astro.site}services/${s.slug}/`, provider: { '@id': `${Astro.site}#organization` },
  areaServed: MARKETS.map((m) => ({ '@type': 'Place', name: m.name })),
}]}>

  <!-- 1 · HERO — the outcome, two ways to act, three reasons to believe it -->
  <section class={`hero hero--svc${heroFile ? '' : ' turf-marks turf-marks--dark'}`}>
    <HeroImage file={heroFile} />
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <a href="/services/">Services</a> <span aria-hidden="true">/</span>
        <span>{s.name}</span>
      </nav>
      <p class="hero__eyebrow">{s.eyebrow}</p>
      <h1>{s.h1}</h1>
      <p class="hero__lede">{s.lede}</p>
      <ul class="hero__wins">{s.wins.map((w) => <li>{w}</li>)}</ul>
      <div class="hero__cta">
        <a class="btn btn--primary btn--lg" href="/estimate/" data-estimate={s.preset} data-cta={`quote-hero-${s.slug}`}>Request a free estimate<Icon name="arrow" /></a>
        {phoneHref && <a class="btn btn--ghost btn--lg" href={phoneHref} data-cta={`call-hero-${s.slug}`}><Icon name="phone" />Call <span class="nowrap">{phone}</span></a>}
      </div>
      <ul class="hero__trust">
        <li><Icon name="check" />Layout approved before installation</li>
        {materials && <li><Icon name="check" />American-made turf</li>}
        <li><Icon name="check" />Free estimates, no pressure</li>
      </ul>
    </div>
  </section>


  <!-- 2 · WHAT YOU GET -->
  <section class="sec">
    <div class="wrap">
      <div class="kick kick--left" data-reveal>
        <p class="micro">What you get</p>
        <h2>{s.benefitsHeading}</h2>
      </div>
      <ul class="benefits benefits--summary">
        {s.benefits.map((b) => (
          <li class="benefit" data-reveal>
            <span class="benefit__ico"><Icon name={b.icon} /></span>
            <h3>{b.h}</h3>
            <p>{b.p}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>


  <!-- 3 · THE WORK -->
  {work.length > 0 && (
  <section class="sec sec--dark on-dark">
    <div class="wrap">
      <div class="kick kick--left" data-reveal>
        <p class="micro">Our work</p>
        <h2>{s.workHeading}</h2>
      </div>
      <div class="workgrid">
        {work.map((w, i) => <Figure shot={w} sizes={`(min-width: 1180px) 580px, (min-width: 700px) 46vw, ${i === 0 || (i === work.length - 1 && work.length % 2 === 0) ? '92vw' : '44vw'}`} reveal />)}
      </div>
      <div class="mosaic__actions">
        <a class="btn btn--light" href="/estimate/" data-estimate={s.preset} data-cta={`quote-work-${s.slug}`}>Request a free estimate<Icon name="arrow" /></a>
      </div>
    </div>
  </section>
  )}


  <!-- 4 · WHAT'S INCLUDED -->
  <section class="sec sec--band">
    <div class="wrap includes">
      <div data-reveal>
        <p class="micro">Build it your way</p>
        <h2>{s.options.heading}</h2>
        <ul class="checks">{s.options.items.map((i) => <li><Icon name="check" />{i}</li>)}</ul>
      </div>
      <div data-reveal>
        <p class="micro">Your installation includes</p>
        <h2>What’s included.</h2>
        <ul class="checks">{s.inclusions.map((i) => <li><Icon name="check" />{i}</li>)}</ul>
      </div>
    </div>
  </section>


  <!-- 5 · HOW IT WORKS -->
  <Process />


  <!-- 6 · QUESTIONS — the first one open, so the depth shows without a tap -->
  <section class="sec sec--band">
    <div class="wrap">
      <div class="kick" data-reveal>
        <p class="micro">FAQ</p>
        <h2>Questions about {s.name.toLowerCase()}.</h2>
      </div>
      <div class="faq" data-reveal>
        {s.faq.map((f, i) => (
          <details class="qa" open={i === 0}><summary><h3>{f.q}</h3></summary><p set:html={f.a} /></details>
        ))}
      </div>
      {reads.length > 0 && (
        <div class="rules" data-reveal>
          <p class="micro">More questions, answered</p>
          <ul class="lawlinks lawlinks--light">{reads.map((r) => <li><a href={`/blog/${r.id}/`} data-cta={`guide-blog-${r.id}`}>{r.data.h1}</a></li>)}</ul>
        </div>
      )}
    </div>
  </section>


  <!-- Optional practical follow-up questions; no automatic research appendix. -->
  <Extra slug={s.slug} collapsed />


  <!-- 8 · WHERE WE WORK -->
  <section class="sec">
    <div class="wrap">
      <div class="kick kick--left" data-reveal>
        <p class="micro">Where we work</p>
        <h2>Do we come to you?</h2>
      </div>
      <ul class="areas">
        {MARKETS.map((m) => (
          <li class="arearow" data-reveal>
            <a href={areaPages.has(m.slug) ? `/${m.slug}/${s.slug}/` : `/${m.slug}/`} data-cta={`market-${m.slug}`}>
              <span class="arearow__n"><Icon name="pin" class="arearow__pin" />{m.name}</span>
              <span class="arearow__t">{m.towns.join(' · ')}</span>
              <span class="arearow__g">{areaPages.has(m.slug) ? `${s.name} in ${m.name}` : 'See the area'} &rarr;</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="proof__note">Don&rsquo;t see your town? Call and ask.</p>
    </div>
  </section>


  <!-- 9 · THE OFFER — the wizard opens with this service already chosen -->
  <OfferPanel band preset={s.preset} cta={s.slug} heading={s.close} pics={s.work.slice(0, 3)} />

</Base>
