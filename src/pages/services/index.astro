---
import Base from '../../layouts/Base.astro';
import { SERVICES } from '../../data/services';
import { phone, phoneHref } from '../../data/brief';
const crumbs = [
  { name: 'Home', item: `${Astro.site}` },
  { name: 'Services', item: `${Astro.site}services/` },
];
---
<Base
  title="What We Install | TIMELESS Grass & Greens"
  description={`Putting greens, residential and pet turf, commercial, sports fields, indoor facilities, and turf removal. Three markets. Call ${phone}.`}
  crumbs={crumbs}
>
  <section class="hero hero--sub mown-stripe mown-stripe--dark">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span> <span>Services</span>
      </nav>
      <h1>Anything that&rsquo;s turf.</h1>
      <hr class="rule-ribbon" />
      <p class="hero__lede">Seven things we install, and what actually differs between them.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <ul class="idx" data-reveal>
        {SERVICES.map((s) => (
          <li><a href={`/services/${s.slug}/`} data-cta={`svc-${s.slug}`}>
            <span class="idx__n">{s.name}</span>
            <span class="idx__d">{s.lede}</span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec sec--dark on-dark close">
    <div class="wrap" data-reveal>
      <h2>Not sure which one you need?</h2>
      <p class="close__p">Describe the space and we will tell you which of these it is.</p>
      {phoneHref && <a class="btn btn--primary btn--lg" href={phoneHref} data-cta="call-services-index">Call {phone}</a>}
    </div>
  </section>
</Base>
