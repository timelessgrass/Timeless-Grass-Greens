---
import Base from '../../layouts/Base.astro';
import Extra from '../../components/Extra.astro';
import Icon from '../../components/Icon.astro';
import OfferPanel from '../../components/OfferPanel.astro';
import { SERVICES } from '../../data/services';
import { phone } from '../../data/brief';
const crumbs = [
  { name: 'Home', item: `${Astro.site}` },
  { name: 'Services', item: `${Astro.site}services/` },
];
---
<Base
  title="What We Install | TIMELESS Grass & Greens"
  description={`Putting greens, artificial lawns, pet turf, commercial turf, sports fields, indoor facilities and turf replacement. Free estimates: call ${phone}.`}
  crumbs={crumbs}
>
  <section class="hero hero--sub turf-marks turf-marks--dark">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span> <span>Services</span>
      </nav>
      <h1>Anything that&rsquo;s turf.</h1>
      <hr class="rule-ribbon" />
      <p class="hero__lede">Pick what you&rsquo;re planning. Every job starts with a free visit and a written price.</p>
      <div class="hero__cta">
        <a class="btn btn--primary btn--lg" href="/estimate/" data-estimate data-cta="quote-services-hero">Get a free estimate<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <ul class="benefits">
        {SERVICES.map((s) => (
          <li class="benefit benefit--link" data-reveal>
            <a href={`/services/${s.slug}/`} data-cta={`svc-${s.slug}`}>
              <span class="benefit__ico"><Icon name={s.icon} /></span>
              <h2 class="benefit__h">{s.name}</h2>
              <p>{s.line}</p>
              <span class="benefit__go">See {s.name.toLowerCase()}<Icon name="arrow" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Extra slug="services-index" collapsed />
  <OfferPanel cta="services-index" />
</Base>
