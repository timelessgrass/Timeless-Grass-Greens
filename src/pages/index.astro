---
import HeroImage from '../components/HeroImage.astro';
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { businessName, phone, phoneHref, services, identity, positioning, fact } from '../data/brief';
import { SHOTS, shotsBy, heroSrc, haveCount, floorCount } from '../data/shotlist';
import { MARKETS } from '../data/markets';

/* Structure follows the reference the client chose (a 13-section turf landing page):
   hero → true numbers → gallery → story → standard → services → differentiators →
   process → before/after → FAQ → form → close. Two of its sections are NOT reproduced:
   a review count-up and a "10,000+ homeowners" claim. We have neither sourced, and
   inventing them is precisely what the old site was caught doing. The count-up mechanic
   runs on true numbers instead; the AI-visualizer slot becomes a scroll-scrubbed
   before/after on our own shot list. */

const founded  = fact<number>(identity?.founded_year);
const materials = fact<string>(positioning?.materials);
const hero = heroSrc();
const DEV = import.meta.env.DEV;

const ANSWER = {
  question: 'Who installs artificial turf and putting greens in Denver, Myrtle Beach and Jacksonville?',
  answer: `${businessName} installs artificial turf and backyard putting greens across the Denver metro, the Grand Strand in South and North Carolina, and northeast Florida. Residential lawns, pet turf, commercial installs, indoor facilities and sports fields. The founder has thirteen years in turf. Call ${phone} for a quote.`,
};

const SVC = [
  { slug: 'putting-greens',       name: 'Putting greens',        line: 'Practise at home instead of booking a tee time. Your break, fringe and cup get drawn before anything is cut, because a green that rolls wrong gets used twice and then ignored.' },
  { slug: 'residential-turf',     name: 'Residential lawns',     line: 'Get your weekends back. No mowing, no watering, no reseeding the same bare patch every spring — and a base built for your ground so it stays flat.' },
  { slug: 'pet-turf',             name: 'Pet turf',              line: 'Tired of mud on the floor and a dead strip where the dog runs? Pet turf drains, and we build the drainage before we build the lawn.' },
  { slug: 'commercial-turf',      name: 'Commercial',            line: 'Your property looks the same in August as it did in April, with nobody out there maintaining it. Heard Colorado banned turf on commercial land? Half right — and the half that matters is on this page.' },
  { slug: 'sports-field-turf',    name: 'Sports fields',         line: 'Play on it all season, in any weather, with no bare patch down the middle by July. Someone on the board will ask how hot it gets — we answer that one honestly.' },
  { slug: 'indoor-turf',          name: 'Indoor facilities',     line: 'Train all year, whatever it is doing outside. Indoors nothing rinses it and nothing dries it, so the cleaning plan is part of the job rather than something you work out later.' },
];

/* One frame per service. `shot: null` is deliberate on indoor facilities — there is no
   indoor install in the shot list, and a lawn photograph next to the word "indoor" would
   be a claim. That row shows the measurement instead. */
const byId = (id: string) => SHOTS.find((x) => x.id === id) ?? null;
const SVCFIG = [
  { shot: byId('fin-1') },   // putting greens — a finished green, flag in
  { shot: byId('fin-2') },   // residential lawns — a back lawn to the patio edge
  { shot: byId('fin-3') },   // pet turf — the dog under the deck
  { shot: byId('fin-4') },   // commercial — the shared amenity lawn
  { shot: byId('ctx-1') },   // sports fields — practice nets and goals
  { shot: null },            // indoor facilities — no photograph on file
].map((f) => ({ shot: f.shot && f.shot.file ? f.shot : null }));

/* Was four "why us" points, and every one of them restated something the page already
   said better somewhere else — American-made (hero), soil sets the base (hero deck, the
   cross-section, the lawns card), thirteen years (the ledger), count the leaves (the band,
   almost verbatim). Nothing was lost by replacing them; four duplications were. This
   answers a question nothing on the page answered: what do I actually receive?
   Sourced to the old site's step 02 — "a detailed quote with material options, layout, and
   next steps before any work begins" — and to the process section's base-and-drainage. */
const QUOTE_HAS = [
  { h: 'The turf, named',        p: 'Not “premium grass”. The actual product, and what the cheaper one would have cost you.' },
  { h: 'How deep the base goes', p: 'The biggest line in the price, and the one you can never check once the grass is down. So you get it in writing first.' },
  { h: 'The layout, drawn',     p: 'Where the seams fall, where the edges land, and on a green, where the break runs.' },
  { h: 'What happens next',     p: 'The order of the work, and what we need from you. No deposit to get any of it.' },
];

const pair = (id: string) => ({ b: SHOTS.find((s) => s.pairId === id && s.kind === 'before')!, a: SHOTS.find((s) => s.pairId === id && s.kind === 'after')! });
/* A wipe scrubs an AFTER photograph across a BEFORE photograph. With neither on file the
   section shipped four empty frames wearing "Before" and "After" tags, under a heading
   inviting you to watch it change. Only pairs where BOTH photographs exist are rendered,
   and the section disappears entirely until at least one does. */
const PAIRS = ['ba-1', 'ba-2', 'ba-3', 'ba-4'].filter((id) => { const p = pair(id); return !!p.b?.file && !!p.a?.file; });
---
<Base
  title="TIMELESS Grass & Greens — Artificial Turf & Putting Greens"
  description={`Artificial turf, pet turf and backyard putting greens across Denver, the Grand Strand and northeast Florida. Founder with 13 years in turf. Call ${phone}.`}
  answer={ANSWER}
>

  <!-- 1 · HERO -->
  <section class="hero hero--home">
    <HeroImage file={hero} />
    <div class="wrap">
      <p class="hero__eyebrow">Turf, pet turf &amp; putting greens</p>
      <h1>
        <span class="line"><span>Green all year.</span></span>
        <span class="line"><span>No mower, <em>no mud.</em></span></span>
      </h1>
      <ul class="hero__wins">
        <li>No mowing, no watering, no fertilizer</li>
        <li>Green in July and green in February</li>
        <li>Nothing to reseed, no bare patches, no mud</li>
        <li>Turf, pet turf, putting greens and sports fields</li>
      </ul>
      <p class="hero__qual">
        {materials && <><b>American-made turf</b> · </>}<b>Free estimate</b> · <b>No pressure to sign</b>
      </p>
      <div class="hero__cta">
        {phoneHref && <a class="btn btn--primary" href={phoneHref} data-cta="call-hero">Call {phone}</a>}
      </div>
    </div>
    <div class="hero__steps wrap">
      <div><i>1</i><span>You call, or send photos of the space</span></div>
      <div><i>2</i><span>We measure the space, the grade and the drainage</span></div>
      <div><i>3</i><span>You get a written number before work starts</span></div>
    </div>
  </section>


  <!-- 2 · TRUE NUMBERS — four figures on one rule. Cards here were four boxes holding
       one number each, which is a lot of chrome around very little. -->
  <section class="sec">
    <div class="wrap">
      <div class="kick kick--left" data-reveal>
        <p class="micro">Prove it before I read</p>
        <h2>Who you&rsquo;d be hiring.</h2>
      </div>
      <div class="ledger">
        <div class="ledger__i" data-reveal><b class="ledger__n" data-count="13">13</b><span class="ledger__l">years our founder has been installing turf.</span></div>
        {founded && <div class="ledger__i" data-reveal><b class="ledger__n" data-count={founded}>{founded}</b><span class="ledger__l">the year we opened.</span></div>}
        <div class="ledger__i" data-reveal><b class="ledger__n" data-count="3">3</b><span class="ledger__l">markets we install in: Denver, the Grand Strand, northeast Florida.</span></div>
        <div class="ledger__i" data-reveal><b class="ledger__n" data-count="4">4</b><span class="ledger__l">state turf codes published in full on this site. Read yours before you sign anything.</span></div>
      </div>
      <!-- HOLE: no review count, no customer count, no rating. None is sourced. -->
    </div>
  </section>


  <!-- 3 · WHAT GOES WRONG — was a drawn cross-section of the base build-up. It read as
       three green bars, and a homepage is the wrong place to teach soil mechanics anyway.
       Same argument, said the way a customer would say it: here is what you are afraid of,
       here is what causes it. The technical detail lives on the service and guide pages. -->
  <section class="sec sec--green on-dark turf-marks turf-marks--dark">
    <div class="wrap">
      <div class="kick kick--left" data-reveal>
        <p class="micro">Before you sign with anyone</p>
        <h2>Turf fails in three ways. All three start underneath.</h2>
      </div>
      <ul class="wrongs">
        <li data-reveal><b>It goes wavy.</b><span>The ground moved and took the lawn with it. Front Range clay swells up to twenty percent by volume when it gets wet, so a base built for sand will ripple here.</span></li>
        <li data-reveal><b>It holds puddles.</b><span>Turf drains fast. Your ground may not. If nobody checked before the roll went down, the water has nowhere to go.</span></li>
        <li data-reveal><b>It starts to smell.</b><span>Almost always a pet yard where the liquid sits instead of leaving. Washing the grass will not fix it, because the smell is not in the grass.</span></li>
      </ul>
      <p class="wrongs__note">All three are decided before anyone unrolls anything. That is why we measure your ground first and price it second.</p>
    </div>
  </section>


  <!-- 4 · GALLERY — every photograph on file, at three sizes, each drifting at its own
       rate. The uniform strip that was here read as one small frame on a phone and as a
       row of equal boxes on a desktop; fifteen photographs is the only proof asset this
       business has and it was being spent on a carousel. -->
  <section class="sec sec--dark on-dark mosaicsec">
    <div class="wrap">
      <div class="kick kick--left" data-reveal>
        <p class="micro">The work</p>
        <h2>Real yards. Ours.</h2>
        {DEV && haveCount() < floorCount && <p>Build note: {haveCount()} of {floorCount} client photographs on file. Every image below is a labeled stock stand-in for layout review, and none of them ships.</p>}
      </div>
      <div class="mosaic">
        {[...shotsBy('finished').slice(1), ...shotsBy('context'), ...shotsBy('detail')].map((shot) => (
          <Figure shot={shot} sizes="(min-width: 900px) 46vw, 48vw" parallax />
        ))}
      </div>
    </div>
  </section>


  <!-- 5 · STORY -->
  <section class="sec sec--band">
    <div class="wrap story">
      <div data-reveal>
        <p class="micro">Who shows up</p>
        <h2>You will not be handed off.</h2>
        <p>No project manager, no subcontracted crew you have never met. The people who own this company quote your job and then build it — first call to final walkthrough.</p>
        <p>Your number comes from someone standing in your yard, not from a square-footage calculator. What is under your ground sets how deep the base has to go, and that is most of what you are paying for.</p>
        {phoneHref && <a class="btn btn--primary" href={phoneHref} data-cta="call-story">Call {phone}</a>}
      </div>
      <div class="story__fig" data-reveal>{shotsBy('finished').slice(4, 5).map((shot) => <Figure shot={shot} />)}</div>
    </div>
  </section>
  <!-- 6 · BEFORE / AFTER — scroll wipes the after over the before. Gated on real
       pairs; it renders nothing until Brian sends them. Placed in the proof cluster, not
       after the closing CTA where it used to sit. -->
  {PAIRS.length > 0 && (
  <section class="sec sec--green on-dark turf-marks turf-marks--dark">
    <div class="wrap">
      <div class="kick" data-reveal>
        <p class="micro">Same spot, twice</p>
        <h2>Scroll, and watch it change.</h2>
        <p>The same angle before we started and after we left. Keep scrolling — the after wipes across.</p>
      </div>
      <div class="wipes">
        {PAIRS.map((id) => { const p = pair(id); return (
          <div>
            <div class="wipe" data-reveal>
              <span class="wipe__tag wipe__tag--b">Before</span><span class="wipe__tag wipe__tag--a">After</span>
              <Figure shot={p.b} />
              <div class="wipe__after"><Figure shot={p.a} /></div>
              <span class="wipe__line"></span>
            </div>
            {p.a.caption && <p class="wipe__cap">{p.a.caption}</p>}
          </div>
        ); })}
      </div>
    </div>
  </section>
  )}
  <!-- 7 · SERVICES — six names as display type; the frame beside them changes as you read.
       Six boxes of body copy meant nobody read the sixth. Indoor facilities gets the
       measurement instead of a photograph: we have no indoor install on file, and a
       borrowed lawn photograph beside the word "indoor" is a claim. -->
  <section class="sec">
    <div class="wrap">
      <div class="kick kick--left" data-reveal>
        <p class="micro">What we install</p>
        <h2>Anything that&rsquo;s turf.</h2>
      </div>
      <div class="svcwrap">
        <ol class="svclist" data-svclist>
          {SVC.map((s, i) => (
            <li class={`svcrow${i === 0 ? ' is-on' : ''}`} data-svc={i}>
              <a href={`/services/${s.slug}/`} data-cta={`svc-${s.slug}`}>
                <span class="svcrow__n"><i class="svcrow__i">0{i + 1}</i>{s.name}</span>
                <span class="svcrow__p">{s.line}</span>
              </a>
            </li>
          ))}
        </ol>
        <div class="svcfig" data-svcfig aria-hidden="true">
          {SVCFIG.map((f, i) => (
            <div class={`svcfig__f${i === 0 ? ' is-on' : ''}`} data-svcfig-i={i}>
              {f.shot ? <Figure shot={f.shot} sizes="(min-width: 1000px) 42vw, 92vw" /> : (
                <div class="svcfig__data">
                  <b>27<i>h</i></b>
                  <span>MRSA stayed viable that long in sand infill in a 2020 laboratory study &mdash; against two hours on EPDM rubber. Indoors nothing rinses it and nothing dries it, so the cleaning schedule belongs in the job.</span>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- 8 · PROCESS — pinned, scroll advances the steps -->
  <section class="proc sec sec--green on-dark turf-marks turf-marks--dark">
    <div class="wrap proc__in">
      <div>
        <p class="micro">How a job goes</p>
        <h2 style="color:var(--ink-on-dark)">You call. We measure.<br />You get a number.</h2>
        <div class="proc__bar"><div class="proc__fill"></div></div>
      </div>
      <div class="proc__steps">
        <div class="proc__step"><i>01</i><h3>You call, or send photos</h3><p>Tell us what the space is for. Dogs, kids, putting, a commercial site — that changes the turf before it changes the price.</p></div>
        <div class="proc__step"><i>02</i><h3>Somebody comes out and measures</h3><p>We come to you and check the ground, the grade and the drainage. That is what sets the price, so it happens before the price does.</p></div>
        <div class="proc__step"><i>03</i><h3>You read it before you decide</h3><p>Turf options, layout and what happens next. If a cheaper turf will do your job, we say so and tell you what you give up.</p></div>
        <div class="proc__step"><i>04</i><h3>You approve the design, then we build</h3><p>Nothing is cut until you have said yes to the design. Prep, base, turf, infill, edges and the cleanup are all ours.</p></div>
      </div>
    </div>
  </section>
  <!-- 9 · WHAT IS IN THE QUOTE — the page never told anyone what they actually receive. -->
  <section class="sec sec--dark on-dark">
    <div class="wrap">
      <div class="split">
        <div class="split__head" data-reveal>
          <p class="micro">Before you decide</p>
          <h2>What lands in your inbox.</h2>
          <p>Four things, in writing, before a spade goes in the ground.</p>
          {phoneHref && <a class="btn btn--light" href={phoneHref} data-cta="call-diff">Call {phone}</a>}
        </div>
        <div class="diffs">
          {QUOTE_HAS.map((d) => <div class="diff" data-reveal><h3>{d.h}</h3><p>{d.p}</p></div>)}
        </div>
      </div>
    </div>
  </section>


  <!-- 10 · THE STANDARD — the sentence says zoom in and count the leaves, so the
       photograph starts close and pulls back to the whole clean green as you read it. -->
  <section class="sec sec--green on-dark turf-marks turf-marks--dark turf-marks--drift">
    <div class="wrap zoomband">
      <div data-reveal>
        <p class="micro">How to judge any installer</p>
        <h2>Zoom in on their green. Count the leaves.</h2>
        <p class="band__p">Open any installer&rsquo;s site, find their photo of their own putting green, and count the leaves on it. A blower costs nothing and takes two minutes. If a crew could not be bothered on the one shot everybody sees first, ask what else got skipped the day they drove away. Run it on us too &mdash; the greens above are ours.</p>
        {phoneHref && <a class="btn btn--light" href={phoneHref} data-cta="call-standard">Call {phone}</a>}
      </div>
      <div class="zoomfig" data-zoom>{shotsBy('finished').slice(5, 6).map((shot) => <Figure shot={shot} sizes="(min-width: 950px) 56vw, 100vw" />)}</div>
    </div>
  </section>


  <!-- 11 · FAQ -->
  <section class="sec">
    <div class="wrap">
      <div class="kick" data-reveal>
        <p class="micro">Before you call</p>
        <h2>The questions we actually get.</h2>
      </div>
      <div class="faq" data-reveal>
        <details class="qa"><summary><h3>Does artificial turf get hot?</h3></summary>
          <p>Yes. Hotter than asphalt. Measured across a full day, synthetic surfaces averaged about 117&deg;F against 78&deg;F for natural grass and 110&deg;F for asphalt, with a peak of 200&deg;F on a 98&deg;F day (Williams and Pulley, Brigham Young University). If an installer tells you it runs cooler than your driveway, they are wrong.</p>
          <p>It is a contact problem, not an air problem. A 2024 review of 23 studies found air temperature over turf only 1&ndash;2&deg;F higher. Fine in shoes. Real for bare feet and paws. Shade does more than any infill swap — in that same review shade was worth about 25&deg;C, against 3.2 to 7.9&deg;C for changing infill. Where a spot is wrong for turf, we say so.</p>
        </details>
        <details class="qa"><summary><h3>Are there rebates for tearing out my lawn?</h3></summary>
          <p>Not in Horry County. We searched the Grand Strand Water &amp; Sewer Authority programs and the Horry County, Myrtle Beach and North Myrtle Beach codes. No turf rebate, no water rebate, no landscape-conversion incentive. Colorado and Florida differ by water district, and most Western rebates pay for living plantings rather than synthetic turf — Castle Rock Water pays $3.25 a square foot and excludes artificial turf in writing.</p>
          <p>Test any rebate claim in ninety seconds. Ask for the program name, the URL, the dollar amount per square foot, and the sentence in the rules that says synthetic turf qualifies. A real program has all four. Ask us before you count on any of it applying to your address.</p>
          <p class="qa__links"><a href="/guides/no-turf-rebates-grand-strand/" data-cta="guide-rebates-sc">Why there are no turf rebates in Horry County</a><a href="/guides/colorado-water-rebates-and-turf/" data-cta="guide-rebates-co">Denver-metro water rebates and artificial turf</a></p>
        </details>
        <details class="qa"><summary><h3>What does it cost?</h3></summary>
          <p>Per job, after measuring. The base is most of the work, so the number comes from what is under your yard rather than what goes on top of it. Square footage, access, what comes out, drainage and the product all move it. A small job costs more per square foot than a large one, because a day on site costs the same either way.</p>
          <p>If two quotes are thousands apart, find out what changed. Ask both for base depth, roll widths and seam count, and infill weight per square foot — the parts you can never see once the turf is down. That is usually where the difference is hiding.</p>
        </details>
        <details class="qa"><summary><h3>Will it smell if I have dogs?</h3></summary>
          <p>Only if drainage fails. The blades are inert — urine passes straight through them and settles in the infill and at the backing, which is why washing the grass never fixes it. The smell is not in the grass.</p>
          <p>A pet run needs infill and a base built to move liquid, and that is decided before anyone unrolls turf. Florida wrote the infill half of it into a rule.</p>
          <p class="qa__links"><a href="/guides/florida-turf-infill-rules/" data-cta="guide-infill">What northeast Florida allows as infill</a></p>
        </details>
      </div>
    </div>
  </section>


  <!-- 12 · SERVICE AREAS — three rows, not three boxes. Towns are markets.ts `towns`
       only: the places Brian named on the call or on his own site. src/data/cities/ holds
       170 researched towns; those are page candidates, not a coverage claim. -->
  <section class="sec sec--band">
    <div class="wrap">
      <div class="kick kick--left" data-reveal>
        <p class="micro">Do you come to my town</p>
        <h2>Three markets. Here is where we work.</h2>
      </div>
      <ul class="areas" id="markets">
        {MARKETS.map((m) => (
          <li class="arearow" data-reveal>
            <a href={`/${m.slug}/`} data-cta={`market-${m.slug}`}>
              <span class="arearow__n">{m.name}</span>
              <span class="arearow__t">{m.towns.join(' · ')}</span>
              <span class="arearow__g">See the area &rarr;</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="proof__note">Not on the list? Each market runs wider than the towns named here &mdash; the market page carries the whole area, and a call settles it in a minute.</p>
    </div>
  </section>


  <!-- 13 · ANSWER BOX — authored for extraction -->
  <section class="sec answer-box"><div class="wrap" data-reveal>
    <p class="micro">The short version</p>
    <h2 class="answer-box__q">{ANSWER.question}</h2>
    <p class="answer-box__a">{ANSWER.answer}</p>
  </div></section>


  <!-- 14 · FORM -->
  <section class="sec sec--band" id="quote">
    <div class="wrap formband">
      <div data-reveal>
        <p class="micro">Get a number on it</p>
        <h2>Tell us what the space is for.</h2>
        <p>Dogs, kids, putting, or a commercial site — that one answer changes the turf and the base, so it is the first thing we ask. Four fields, or call {phone} and skip the form.</p>
      </div>
      <!-- THE one form. Lead destination is not wired: brief.conversion.lead_destination is UNKNOWN. Gate 10 blocks launch until all eight test_lead flags are true. -->
      <form class="quote" name="quote" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="company" data-cta="quote-form" aria-labelledby="quote-h" data-reveal>
        <input type="hidden" name="form-name" value="quote" />
        <p class="hp" aria-hidden="true"><label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label></p>
        <p class="micro micro--accent" id="quote-h">Request a free estimate</p>
        <div class="quote__row">
          <label class="fld"><span>Name</span><input type="text" name="name" autocomplete="name" required /></label>
          <label class="fld"><span>Phone</span><input type="tel" name="phone" autocomplete="tel" inputmode="tel" required /></label>
        </div>
        <div class="quote__row">
          <label class="fld"><span>Town or ZIP</span><input type="text" name="town" autocomplete="postal-code" required /></label>
          <label class="fld"><span>What&rsquo;s the space for?</span>
            <select name="use" required><option value="">Choose one</option><option>Lawn</option><option>Dogs</option><option>Putting green</option><option>Kids / play area</option><option>Commercial or sports field</option></select>
          </label>
        </div>
        <button class="btn btn--primary" type="submit">Request a quote</button>
        <p class="quote__note">We call back with questions, not a pitch.</p>
      </form>
    </div>
  </section>


  <!-- 15 · CLOSE — no invented scarcity. The reference claims a booking window; we have none stated. -->
  <section class="sec sec--dark on-dark close close--big turf-marks turf-marks--dark turf-marks--drift">
    <div class="wrap" data-reveal>
      <h2>Stop maintaining it. Start using it.</h2>
      <p class="close__p">One visit and you will know what your yard costs. Nothing is ordered, dug or cut until you have said yes to the number.</p>
      {phoneHref && <a class="btn btn--primary btn--lg" href={phoneHref} data-cta="call-close">Call {phone}</a>}
    </div>
  </section>


</Base>
