---
import AreaMap from '../../components/AreaMap.astro';
import HeroImage from '../../components/HeroImage.astro';
import Extra from '../../components/Extra.astro';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import { MARKETS } from '../../data/markets';
import { shotsBy, heroSrc } from '../../data/shotlist';
import { SERVICES } from '../../data/services';
import { businessName, phone, phoneHref } from '../../data/brief';

export function getStaticPaths() {
  return MARKETS.map((m) => ({ params: { market: m.slug }, props: { m } }));
}
const { m } = Astro.props;
const hero = heroSrc(); // TODO per-market hero once the client's photos land; all stock for now

const ANSWER = {
  question: `Who installs artificial turf and putting greens in ${m.short}?`,
  answer: `${businessName} installs artificial turf, pet turf and backyard putting greens across ${m.name} — ${m.anchors.slice(0, 4).join(', ')} and the surrounding area. Residential, commercial, indoor facilities and sports fields. 13 years' experience. Call ${phone} for a free estimate.`,
};

const crumbs = [
  { name: 'Home', item: `${Astro.site}` },
  { name: m.name, item: `${Astro.site}${m.slug}/` },
];
---
<Base
  title={`Artificial Turf in ${m.short} | TIMELESS Grass & Greens`}
  description={`Artificial turf, pet turf and backyard putting greens across ${m.name} — ${m.anchors.slice(0,3).join(', ')} and between. Call ${phone}.`}
  answer={ANSWER}
  crumbs={crumbs}
>
  <section class="hero hero--sub turf-marks turf-marks--dark">
    <HeroImage file={hero} />
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span> <span>{m.name}</span>
      </nav>
      <p class="micro micro--accent">{m.towns.join(' · ')}</p>
      <h1>Turf and putting greens across {m.name}.</h1>
      <hr class="rule-ribbon" />
      <p class="hero__lede">{m.ground}</p>
      <div class="hero__cta">
        {phoneHref && <a class="btn btn--primary" href={phoneHref} data-cta={`call-hero-${m.slug}`}>Call {phone}</a>}
      </div>
    </div>
  </section>

  <!-- the regulatory fact no competitor in this market has written up -->
  <section class="sec sec--green on-dark turf-marks turf-marks--dark">
    <div class="wrap band" data-reveal>
      <p class="micro">What changes here</p>
      <h2>{m.law.headline}</h2>
      <p class="band__p">{m.law.detail}</p>
      <p class="src">{m.law.source}</p>
      <ul class="lawlinks">
        {m.guides.map((g) => <li><a href={`/guides/${g.slug}/`} data-cta={`guide-${g.slug}`}>{g.anchor}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <p class="micro" data-reveal>What we install in {m.short}</p>
      <h2>Anything that&rsquo;s turf.</h2>
      <ul class="svcs">
        {SERVICES.slice(0, 6).map((s) => (
          <li class="svc" data-reveal><a href={`/services/${s.slug}/`} data-cta={`svc-${s.slug}`}><span class="svc__n">{s.name}</span><span class="idx__d">{s.lede}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec sec--band">
    <div class="wrap">
      <p class="micro" data-reveal>Where we work</p>
      <h2>Towns we work in across {m.short}.</h2>
      <div class="towns__split">
        <ul class="towns" data-reveal>
          {m.anchors.map((t) => <li>{t}</li>)}
        </ul>
        <div data-reveal><AreaMap query={m.map.query} zoom={m.map.zoom} places={m.towns} label={m.name} /></div>
      </div>
    </div>
  </section>

  <section class="sec sec--dark on-dark">
    <div class="wrap">
      <p class="micro" data-reveal>The work</p>
      <h2>Some of our work.</h2>
      <div class="proof__grid">
        {shotsBy('finished').slice(0, 3).map((shot) => <Figure shot={shot} />)}
      </div>
    </div>
  </section>

  <section class="sec sec--band answer-box">
    <div class="wrap" data-reveal>
      <p class="micro">The short version</p>
      <h2 class="answer-box__q">{ANSWER.question}</h2>
      <p class="answer-box__a">{ANSWER.answer}</p>
    </div>
  </section>

  <Extra slug={m.slug} />
  <section class="sec sec--dark on-dark close">
    <div class="wrap" data-reveal>
      <p class="micro">What happens next</p>
      <h2>You call, we measure, you get a number.</h2>
      {phoneHref && <a class="btn btn--primary btn--lg" href={phoneHref} data-cta={`call-close-${m.slug}`}>Call {phone}</a>}
    </div>
  </section>
</Base>
