---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Process from '../components/Process.astro';
import { phone, phoneHref } from '../data/brief';
const title = 'Got it | TIMELESS Grass & Greens';
const description = 'Your estimate request is in. We will call to set up your free visit. If it cannot wait, call 303-349-2368.';
---
<Base title={title} description={description} robots="noindex, nofollow">
  <section class="hero hero--sub turf-marks turf-marks--dark">
    <div class="wrap">
      <p class="micro micro--accent">Request received</p>
      <h1>Got it. We&rsquo;ll call you back.</h1>
      <hr class="rule-ribbon" />
      <p class="hero__lede">Next is your free visit: we measure the space, check the drainage and put your price in writing.</p>
      <div class="hero__cta">
        {phoneHref && <a class="btn btn--primary" href={phoneHref} data-cta="call-thanks"><Icon name="phone" />Can&rsquo;t wait? Call {phone}</a>}
        <a class="btn btn--ghost" href="/" data-cta="home-thanks">Back to the homepage</a>
      </div>
    </div>
  </section>

  <!-- what happens next: the same four steps the rest of the site promises -->
  <Process micro="What happens next" heading="Next: a free visit and a written price." />
</Base>
